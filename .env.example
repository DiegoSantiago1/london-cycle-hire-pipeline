# Copie este arquivo para .env e defina uma senha própria.
# O .env nunca é commitado (veja .gitignore).

# Banco deste projeto, no container PostgreSQL compartilhado.
# 127.0.0.1 e não "localhost": no Windows, localhost resolve primeiro para o IPv6 ::1,
# mas o container publica a porta só em 127.0.0.1 (IPv4); cada conexão esperaria o
# timeout do ::1 antes de tentar o IPv4.
BICICLETAS_DB_HOST=127.0.0.1
BICICLETAS_DB_PORT=5432
BICICLETAS_DB_NAME=bicicletas
# Banco dos testes automatizados: é APAGADO e recriado a cada execução do pytest.
# Precisa ser diferente de BICICLETAS_DB_NAME (a configuração recusa se forem iguais).
BICICLETAS_DB_NAME_TESTE=bicicletas_teste
BICICLETAS_DB_USER=bicicletas
BICICLETAS_DB_PASSWORD=troque_esta_senha

# Container e superusuário usados só pelo "python -m bicicletas.bootstrap" (via docker
# exec, sem senha: dentro do container o psql conecta pelo socket local). O bootstrap
# se recusa a alterar um usuário que seja superusuário ou dono de bancos de outro projeto.
BICICLETAS_DOCKER_CONTAINER=honda-vendas-db
BICICLETAS_DOCKER_SUPERUSER=honda

# Pasta dos dados brutos grandes (CSVs de viagens), FORA do OneDrive (DECISOES.md D15).
BICICLETAS_DADOS=C:\Users\freit\dados\london-cycle-hire
